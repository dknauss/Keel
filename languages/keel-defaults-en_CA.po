# Canadian English for Keel Defaults.
#
# Not shipped in the plugin zip — see .distignore. wordpress.org generates and
# delivers per-locale catalogs from translate.wordpress.org, so this is kept as
# the source of the two Canadian spellings to contribute there, not as a copy
# that installs alongside them.
#
# en_US is the source locale, so this catalog exists only to swap American
# spellings for Canadian ones. Two strings need it out of 244; everything else
# is identical and is deliberately not repeated here, because a duplicated string
# is one that can drift from its source without anything noticing.
#
# Regenerate the template with: wp i18n make-pot . languages/keel-defaults.pot --slug=keel-defaults --exclude=build
# Recompile this catalog with:  wp i18n make-mo languages/
msgid ""
msgstr ""
"Project-Id-Version: Keel Defaults 0.5.8\n"
"Report-Msgid-Bugs-To: https://wordpress.org/support/plugin/keel-defaults\n"
"Language: en_CA\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=n != 1;\n"

msgid "The defaults that are on out of the box are low-risk and safe for nearly any site. Anything that can change behavior or break an integration — requiring authentication for all REST requests, blocking the XML-RPC endpoint, the Classic editor — is off by default and opt-in only."
msgstr "The defaults that are on out of the box are low-risk and safe for nearly any site. Anything that can change behaviour or break an integration — requiring authentication for all REST requests, blocking the XML-RPC endpoint, the Classic editor — is off by default and opt-in only."

msgid "Adds a color-coded label to the admin bar showing the current environment (Production, Staging, Development, or Local) from <code>wp_get_environment_type()</code> — a quick guard against acting on the wrong site. Common local-development hosts are recognized automatically. Off by default."
msgstr "Adds a colour-coded label to the admin bar showing the current environment (Production, Staging, Development, or Local) from <code>wp_get_environment_type()</code> — a quick guard against acting on the wrong site. Common local-development hosts are recognised automatically. Off by default."
