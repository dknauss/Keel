#: keel.php:2666
#, php-format
msgid "See <a href=\"%s\">Site Health</a> for a read-only summary of every default and its state."
msgstr ""

#: keel.php:2810
msgid "Each switch below is one opinionated default. Flip what you want; the rest of WordPress is untouched."
msgstr ""

#: keel.php:2827
msgid "Update policy overridden: AUTOMATIC_UPDATER_DISABLED disables every WordPress background update."
msgstr ""

#: keel.php:2831
msgid "Update policy overridden: DISALLOW_FILE_MODS prevents WordPress from installing updates."
msgstr ""

#: keel.php:2837
msgid "Core update policy is locked by WP_AUTO_UPDATE_CORE in wp-config.php. Remove that constant to manage core releases here."
msgstr ""

