#: includes/settings-page.php:58
#, php-format
msgid "See <a href=\"%s\">Site Health</a> for a read-only summary of every default and its state."
msgstr ""

#: includes/settings-page.php:223
msgid "Locked by <code>WP_AUTO_UPDATE_CORE</code> in <code>wp-config.php</code>. Remove that constant to manage core releases here."
msgstr ""

