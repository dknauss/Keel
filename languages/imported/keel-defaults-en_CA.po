msgid "Media"
msgstr "Media"

#: includes/strings.php:257
msgid "Email"
msgstr "Email"

#: includes/strings.php:258
msgid "Admin and Front-End UX"
msgstr "Admin and Front-End UX"

#: includes/strings.php:259
msgid "Login and Sessions"
msgstr "Login and Sessions"

#: includes/strings.php:260
msgid "Branding"
msgstr "Branding"

