#, php-format
msgid "Two things are stopping it: minor updates are switched off, and %s."
msgstr "Two things are stopping it: minor updates are switched off, and %s."

#: includes/backports.php:914
msgid ""
"WordPress has no security-only update setting. Security fixes ship inside "
"ordinary maintenance releases, so switching off minor updates switches off "
"security fixes with them — there is no way to keep one without the other."
msgstr ""
"WordPress has no security-only update setting. Security fixes ship inside "
"ordinary maintenance releases, so switching off minor updates switches off "
"security fixes with them — there is no way to keep one without the other."

#: includes/backports.php:929
msgid "This core version is not currently flagged as insecure"
msgstr "This core version is not currently flagged as insecure"

#. translators: 1: current version, 2: latest version.
#: includes/backports.php:932
#, php-format
msgid ""
"%1$s is not currently flagged as insecure by WordPress.org. The current "
