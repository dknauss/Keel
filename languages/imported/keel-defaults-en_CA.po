msgstr ""
"WordPress.org classifies %1$s as %2$s: it has publicly known "
"vulnerabilities. The nearest release without known vulnerabilities is %4$s, "
"on your own %3$s line."

#: includes/backports.php:878
msgid "insecure"
msgstr "insecure"

