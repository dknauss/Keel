#. translators: %s: target version.
#: includes/backports.php:1295
#, php-format
msgid ""
"Reaching %s means waiting for the scheduled check to install it, or "
"installing it deliberately from the command line."
msgstr ""
"Reaching %s means waiting for the scheduled check to install it, or "
"installing it deliberately from the command line."

#. translators: 1: the version the scheduled check would install, 2: target version.
#: includes/backports.php:1303
#, php-format
msgid ""
"The scheduled check will install %1$s and skip %2$s. Reaching %2$s means "
"installing it deliberately from the command line."
msgstr ""
"The scheduled check will install %1$s and skip %2$s. Reaching %2$s means "
"installing it deliberately from the command line."

#. translators: %s: target version.
#: includes/backports.php:1315
#, php-format
