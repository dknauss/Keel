# Pilot: analyze the listed modules, not the whole plugin.
parameters:
    level: 6
    phpVersion: 70400
    paths:
        - includes/backport-policy.php
        - includes/backport-install.php
        - includes/backport-presentation.php
        - includes/settings-policy.php
        - includes/settings-controls.php
        - includes/updates-screen.php
        - includes/updates.php
        - includes/lifecycle.php
        - includes/email.php
        - includes/conflict-attribution.php
        - includes/conflict-overlap.php
        - includes/conflict-divergence.php
        - includes/conflict-notices.php
        - includes/backport-status.php
        - includes/backport-actions.php
        - includes/password-hibp.php
        - includes/password-policy.php
    scanDirectories:
        - includes
    scanFiles:
        - keel.php
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - tests/phpstan/wordpress-constants.php
    dynamicConstantNames:
        - WP_PLUGIN_DIR
        # The migration target advances; retain version-specific migration guards.
        - KEEL_DEFAULTS_DATA_VERSION
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: true
    typeAliases:
        KeelBlocker: 'array{code: string, text: string}'
        KeelMinorUpdateState: 'array{policy: bool, owner: "option"|"keel"|"constant"|"filter", operable: bool, blockers: list<KeelBlocker>}'
        KeelUpdateScreenOffer: 'array{state: "unknown"|"none"|"hidden"|"visible", manual: mixed}'
        KeelLadderRung: 'array{version: string, same_line: bool, delta: bool}'
        KeelInstallPlan: 'array{offer: object, args: array{allow_relaxed_file_ownership: bool, attempt_rollback: true}}'
        KeelOverlapReport: 'array{structural: array<string, list<string>>, unconfirmed: array<string, list<string>>}'
        KeelPolicyRegistration: 'array{callback: callable|null, priority: int, accepted_args: int, setting: string|array<array-key, string>}'
        KeelBlockerCode: 'array{code: string, text?: string}'
        KeelSelectionState: 'array{operable: true, blockers?: array<array-key,KeelBlockerCode>}|array{operable: false, blockers: array<array-key,KeelBlockerCode>}'
        KeelRouteState: 'array{policy: bool, operable: bool, blockers: array<array-key,KeelBlockerCode>}'
        KeelScheduleState: 'array{policy: bool, operable: bool}'
        KeelBlockerState: 'array{blockers: array<array-key,KeelBlockerCode>}'
        KeelBackportResult: 'array{code: string, messages: array<array-key, string>, type: "success"|"error"}'
        KeelBackportHealthResult: 'array{label: string, status: "good"|"recommended"|"critical", badge: array{label: string, color: "blue"}, description: string, actions: string, test: "keel_backport"}'
        KeelBackportTestRegistration: 'array{label: string, test: "keel_backport", async_direct_test: "keel_defaults_backport_test"}'
        KeelDivergenceMap: 'array<array-key, true>'
        KeelVersionStatus: '"latest"|"outdated"|"insecure"|"unknown"'
        KeelPasswordVerdict: 'true|WP_Error'
        KeelChoiceField: 'array{type: string, values?: array<array-key, mixed>, choices?: array<array-key, int|string>}'
        KeelChoiceCopy: 'array{labels?: array<array-key, string>, choices?: array<array-key, string>}'
        KeelControlField: 'array{type?: string, min?: mixed, max?: mixed, values?: array<array-key, mixed>, choices?: array<array-key, int|string>}'
        KeelControlCopy: 'array{label?: string, unit?: string, labels?: array<array-key, string>, choices?: array<array-key, string>}'
        KeelRangeField: 'array{values: array<array-key, mixed>}'
        KeelRangeCopy: 'array{labels?: array<array-key, string>}'
