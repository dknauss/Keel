{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/options-general.php?page=keel",
	"preferredVersions": { "php": "8.2", "wp": "latest" },
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/dknauss/keel/releases/download/latest/keel.zip"
			},
			"options": { "activate": true, "targetFolderName": "keel" }
		},
		{
			"step": "wp-cli",
			"command": "wp post create --post_type=post --post_title='A post to try the defaults against' --post_status=publish"
		}
	]
}
